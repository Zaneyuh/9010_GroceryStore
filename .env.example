# Copy to .env for development. .env is git-ignored.

# Which role this PC plays: server | terminal | unconfigured
APP_MODE=server
# Terminal PCs only: PC-01, PC-02 or PC-03
TERMINAL_ID=
# Terminal PCs only: LAN address of the server PC (never hardcoded in code)
SERVER_HOST=127.0.0.1
API_PORT=4010

# Server PC only: MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=GroceryApp!
DB_PASSWORD=MyPassword123!
DB_NAME=grocery9010

# First run only: owner PIN (6 digits) and whether to load database/sample-data.sql
LOAD_SAMPLE_DATA=true

# Server PC only: Python for the ML service. Empty = ml_service/.venv (from npm run ml:install)
ML_PYTHON=
